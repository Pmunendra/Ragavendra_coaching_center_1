# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-too-please

# Database
# Default is SQLite - a single file at instance/exam_portal.db, created
# automatically on first run, no setup needed. Leave DATABASE_URL unset to
# use that default. To use a different database instead (e.g. a managed
# Postgres/MySQL instance), set DATABASE_URL to its SQLAlchemy URL, e.g.:
#   postgresql+psycopg2://user:password@host:5432/dbname
#   mysql+pymysql://user:password@host:3306/dbname   (also needs: pip install pymysql)
# If you do want a *different SQLite file/location* than the default, use a
# 4-slash absolute path (sqlite:////full/path/to/file.db) - Flask-SQLAlchemy
# resolves a 3-slash *relative* path against the instance/ folder itself
# (so "sqlite:///instance/x.db" actually becomes instance/instance/x.db,
# not the project-root instance/x.db you'd expect), which is surprising
# enough that it's simplest to just avoid relative SQLite URLs here.
# DATABASE_URL=

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM_NAME=Exam Portal
MAIL_FROM_ADDRESS=your-email@gmail.com

# App
APP_BASE_URL=http://localhost:5000
SESSION_COOKIE_SECURE=false

# --------------------------------------------------------------------------
# Admin login - auto-created on first startup if no admin account exists
# yet (never overwrites an existing admin's password).
# --------------------------------------------------------------------------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# --------------------------------------------------------------------------
# UPI payment (manual verification) - your real UPI ID/name.
# --------------------------------------------------------------------------
UPI_PAYEE_VPA=exam-portal@upi
UPI_PAYEE_NAME=Kalyani Exam Hub

# --------------------------------------------------------------------------
# Razorpay payment gateway (instant/automatic verification).
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys.
# Leave blank to disable the "Pay with Razorpay" button.
# --------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (international/non-INR payments) - leave blank to disable
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_INR_TO_USD_RATE=83

# --------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta) - student support bot + management
# handoff. Get these from https://developers.facebook.com -> your app ->
# WhatsApp -> API Setup. Leave WHATSAPP_ACCESS_TOKEN blank to disable
# outbound sending (bot replies/management replies are skipped, not
# crashed, if left blank - see whatsapp_service.is_configured()).
# --------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
